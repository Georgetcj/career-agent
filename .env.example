# PostgreSQL
POSTGRES_DB=career_agent
POSTGRES_USER=career_agent
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://career_agent:replace-with-a-local-development-password@localhost:5432/career_agent

# Redis
REDIS_PORT=6379

# MinIO (local development only)
MINIO_ROOT_USER=career_agent_minio
MINIO_ROOT_PASSWORD=replace-with-a-local-development-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=career-agent-files
MINIO_PRESIGNED_URL_TTL_SECONDS=300

# Resume upload policy
RESUME_UPLOAD_MAX_SIZE_BYTES=10485760

# Embeddings (use an OpenAI-compatible provider only from the server)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.uiuihao.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_SIZE_CHARS=800
RAG_CHUNK_OVERLAP_CHARS=120
